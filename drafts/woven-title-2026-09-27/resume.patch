+export const WEAVE_DURATION = 3000;
+
+// The first two passes teach the motion; the remaining courses speed up.
+export function weftPass(index: number, count: number) {
+  if (index === 0) return { start: 300, travel: 520, beat: 160 };
+  if (index === 1) return { start: 980, travel: 380, beat: 120 };
+  const interval = (WEAVE_DURATION - 360 - 1480) / Math.max(1, count - 3);
+  return { start: 1480 + (index - 2) * interval, travel: 140, beat: 120 };
+}
