+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+
+import ts from 'typescript';
+
+const source = await readFile(
+  new URL('../src/components/home/weaveMotion.ts', import.meta.url),
+  'utf8',
+);
+const { outputText } = ts.transpileModule(source, {
+  compilerOptions: { module: ts.ModuleKind.ESNext },
+});
+const { WEAVE_DURATION, weftPass } = await import(
+  `data:text/javascript;base64,${Buffer.from(outputText).toString('base64')}`
+);
+
+for (const count of [1, 2, 3, 18, 24, 42]) {
+  let previousStart = -1;
+  for (let index = 0; index < count; index++) {
+    const { start, travel, beat } = weftPass(index, count);
+    assert(start > previousStart, 'Courses must enter in order');
+    assert(travel > 0 && beat > 0, 'Every course must traverse and pack');
+    assert(
+      start + travel + beat <= WEAVE_DURATION,
+      'Weaving must finish in 3s',
+    );
+    previousStart = start;
+  }
+}
+const first = weftPass(0, 24);
+const second = weftPass(1, 24);
+assert.equal(first.start + first.travel + first.beat, second.start);
+assert.equal(second.start + second.travel + second.beat, weftPass(2, 24).start);
+assert(first.travel > second.travel && second.travel > weftPass(2, 24).travel);
+console.log('Weave motion checks passed');
