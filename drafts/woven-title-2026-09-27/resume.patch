+'use client';
+
+import { useEffect, useRef } from 'react';
+
+import { WEAVE_DURATION as DURATION, weftPass } from './weaveMotion';
+
+const TITLE = '태피스토리';
+const WEFT_START = 820;
+const WEFT_TRAVEL = 440;
+const WEFT_SPAN = 1600;
+
+type Strand = {
+  position: number;
+  offset: number;
+  pluckedAt: number;
+  amplitude: number;
+};
+type Loom = {
+  width: number;
+  height: number;
+  fontSize: number;
+  step: number;
+  left: number;
+  top: number;
+  titleWidth: number;
+  titleHeight: number;
+  centerY: number;
+  subtitleTop: number;
+  threadTop: number;
+  threadBottom: number;
+  threadLeft: number;
+  threadRight: number;
+  columns: Strand[];
+  rows: Strand[];
+  titleColumns: Strand[];
+  titleRows: Strand[];
+  courseRows: number[];
+  dye: Float32Array;
+};
+
+const clamp = (value: number) => Math.max(0, Math.min(1, value));
+const easeOut = (value: number) => 1 - (1 - value) ** 3;
+
+function makeLoom(
+  section: DOMRect,
+  guide: DOMRect,
+  subtitle: DOMRect,
+  fontFamily: string,
+): Loom {
+  const { width, height } = section;
+  // Use the original SVG's rendered box instead of guessing its CSS size.
+  const fontSize = guide.width / 6;
+  const step = Math.max(3, fontSize / 32);
+  const titleWidth = guide.width;
+  const titleHeight = guide.height;
+  const left = guide.left - section.left;
+  const top = guide.top - section.top;
+  const centerY = top + titleHeight / 2;
+  const subtitleTop = subtitle.top - section.top;
+  const threadTop = 0;
+  const threadBottom = Math.min(
+    height,
+    subtitle.bottom - section.top + titleHeight * 1.4,
+  );
+  const threadLeft = 0;
+  const threadRight = width;
+  const makeStrand = (position: number): Strand => ({
+    position,
+    offset: 0,
+    pluckedAt: 0,
+    amplitude: 0,
+  });
+  const columns = Array.from({ length: Math.ceil(width / step) + 2 }, (_, i) =>
+    makeStrand(left + (i - Math.ceil(left / step) + 0.5) * step),
+  ).filter((strand) => strand.position >= 0 && strand.position <= width);
+  const rows = Array.from(
+    { length: Math.ceil(threadBottom / step) + 2 },
+    (_, i) => makeStrand(top + (i - Math.ceil(top / step) + 0.5) * step),
+  ).filter((strand) => strand.position >= 0 && strand.position <= threadBottom);
+  const titleColumns = columns.filter(
+    (strand) => strand.position >= left && strand.position < left + titleWidth,
+  );
+  const titleRows = rows.filter(
+    (strand) => strand.position >= top && strand.position < top + titleHeight,
+  );
+
+  // The text supplies a weaving chart only. No visible text mask or text layer is drawn.
+  const chart = document.createElement('canvas');
+  chart.width = Math.ceil(titleWidth);
+  chart.height = Math.ceil(titleHeight);
+  const chartContext = chart.getContext('2d', { willReadFrequently: true });
+  const dye = new Float32Array(titleColumns.length * titleRows.length);
+  if (chartContext) {
+    chartContext.fillStyle = '#fff';
+    chartContext.font = `800 ${fontSize}px ${fontFamily}`;
+    chartContext.letterSpacing = `${-fontSize * 0.025}px`;
+    chartContext.textAlign = 'center';
+    chartContext.textBaseline = 'middle';
+    chartContext.fillText(TITLE, chart.width / 2, chart.height / 2);
+    const pixels = chartContext.getImageData(0, 0, chart.width, chart.height);
+    const sample = (x: number, y: number) => {
+      const px = Math.max(0, Math.min(chart.width - 1, Math.round(x)));
+      const py = Math.max(0, Math.min(chart.height - 1, Math.round(y)));
+      return pixels.data[(py * chart.width + px) * 4 + 3] / 255;
+    };
+    titleRows.forEach((row, j) => {
+      titleColumns.forEach((column, i) => {
+        const x = column.position - left;
+        const y = row.position - top;
+        const spread = step * 0.23;
+        dye[j * titleColumns.length + i] =
+          (sample(x - spread, y - spread) +
+            sample(x + spread, y - spread) +
+            sample(x - spread, y + spread) +
+            sample(x + spread, y + spread)) /
+          4;
+      });
+    });
+  }
+  const courseRows = titleRows
+    .map((_, index) => index)
+    .filter((index) =>
+      dye
+        .subarray(
+          index * titleColumns.length,
+          (index + 1) * titleColumns.length,
+        )
+        .some((coverage) => coverage >= 0.13),
+    )
+    .reverse();
+  return {
+    width,
+    height,
+    fontSize,
+    step,
+    left,
+    top,
+    titleWidth,
+    titleHeight,
+    centerY,
+    subtitleTop,
+    threadTop,
+    threadBottom,
+    threadLeft,
+    threadRight,
+    columns,
+    rows,
+    titleColumns,
+    titleRows,
+    courseRows,
+    dye,
+  };
+}
+
+function strokeWeft(
+  context: CanvasRenderingContext2D,
+  from: number,
+  to: number,
+  spacing: number,
+  yAt: (x: number) => number,
+) {
+  if (from === to) return;
+  context.beginPath();
+  context.moveTo(from, yAt(from));
+  const segments = Math.ceil(Math.abs(to - from) / spacing);
+  for (let point = 1; point <= segments; point++) {
+    const x = from + ((to - from) * point) / segments;
+    context.lineTo(x, yAt(x));
+  }
+  context.stroke();
+}
+
+function drawScene(
+  context: CanvasRenderingContext2D,
+  loom: Loom,
+  elapsed: number,
+  dark: boolean,
+) {
+  const {
+    width,
+    height,
+    step,
+    left,
+    titleWidth,
+    titleHeight,
+    centerY,
+    subtitleTop,
+    threadTop,
+    threadBottom,
+    threadLeft,
+    threadRight,
+    columns,
+    rows,
+    titleColumns,
+    titleRows,
+    courseRows,
+    dye,
+  } = loom;
+  context.clearRect(0, 0, width, height);
+  context.lineCap = 'butt';
+  const edgeOpacity =
+    (dark ? 0.17 : 0.13) + 0.03 * (1 - clamp(elapsed / DURATION));
+  const edgeColor = dark ? '183, 151, 249' : '167, 139, 250';
+  const contrastEnd = Math.min(threadBottom, subtitleTop + titleHeight * 0.35);
+  const lowerContrast = (y: number) => {
+    const progress = clamp(
+      (y - centerY) / Math.max(step, contrastEnd - centerY),
+    );
+    return 1 - 0.6 * progress * progress * (3 - 2 * progress);
+  };
+  const warpFade = context.createLinearGradient(0, threadTop, 0, threadBottom);
+  warpFade.addColorStop(0, `rgba(${edgeColor}, 0)`);
+  warpFade.addColorStop(
+    clamp((centerY - titleHeight * 1.5) / threadBottom),
+    `rgba(${edgeColor}, ${edgeOpacity * 0.55})`,
+  );
+  warpFade.addColorStop(
+    centerY / threadBottom,
+    `rgba(${edgeColor}, ${edgeOpacity})`,
+  );
+  [0.25, 0.5, 0.75, 1].forEach((progress) => {
+    const y = centerY + (contrastEnd - centerY) * progress;
+    warpFade.addColorStop(
+      clamp(y / threadBottom),
+      `rgba(${edgeColor}, ${edgeOpacity * lowerContrast(y)})`,
+    );
+  });
+  warpFade.addColorStop(1, `rgba(${edgeColor}, 0)`);
+  const weftFade = context.createLinearGradient(threadLeft, 0, threadRight, 0);
+  weftFade.addColorStop(0, `rgba(${edgeColor}, 0)`);
+  weftFade.addColorStop(0.15, `rgba(${edgeColor}, ${edgeOpacity})`);
+  weftFade.addColorStop(0.85, `rgba(${edgeColor}, ${edgeOpacity})`);
+  weftFade.addColorStop(1, `rgba(${edgeColor}, 0)`);
+  context.strokeStyle = warpFade;
+  context.lineWidth = step * 0.28;
+  const focus = (distance: number, spread: number) =>
+    Math.exp(-((distance / spread) ** 4));
+  const courseLeft = Math.max(threadLeft, left - titleHeight * 1.2);
+  const courseRight = Math.min(
+    threadRight,
+    left + titleWidth + titleHeight * 1.2,
+  );
+  const passes = courseRows.map((rowIndex, index) => {
+    const timing = weftPass(index, courseRows.length);
+    const age = elapsed - timing.start;
+    const progress = clamp(age / timing.travel);
+    const pack = clamp((age - timing.travel) / timing.beat);
+    return {
+      rowIndex,
+      index,
+      age,
+      progress,
+      pack,
+      y: titleRows[rowIndex].position - step * 3 * (1 - easeOut(pack)),
+      tip:
+        index % 2 === 0
+          ? courseLeft + (courseRight - courseLeft) * progress
+          : courseRight - (courseRight - courseLeft) * progress,
+    };
+  });
+  const working = passes.findLast((pass) => pass.age >= 0 && pass.pack < 1);
+  const shed = working ? Math.sin(working.progress * Math.PI) : 0;
+  const warpXAt = (strand: Strand, index: number, y: number) => {
+    const edgeX = strand.position + (1.5 - (index % 4)) * step * 0.8;
+    const gathered = focus(y - centerY, titleHeight * 1.8);
+    const opening = working
+      ? (index % 2 ? -1 : 1) *
+        step *
+        0.28 *
+        shed *
+        Math.exp(-(((y - working.y) / (titleHeight * 0.4)) ** 2))
+      : 0;
+    return (
+      edgeX + (strand.position - edgeX + strand.offset) * gathered + opening
+    );
+  };
+  const rowStart = (position: number) =>
+    WEFT_START + clamp(position / (centerY + titleHeight * 0.6)) * WEFT_SPAN;
+
+  columns.forEach((strand, i) => {
+    context.globalAlpha = Math.sin((Math.PI * strand.position) / width) ** 0.7;
+    const delay = (i % 4) * 18 + Math.abs(i - columns.length / 2) * 0.12;
+    const progress = Math.max(0.035, easeOut(clamp((elapsed - delay) / 300)));
+    const trace = (from: number, to: number) => {
+      context.moveTo(warpXAt(strand, i, from), from);
+      const segments = Math.ceil(Math.abs(to - from) / 18);
+      for (let point = 1; point <= segments; point++) {
+        const y = from + ((to - from) * point) / segments;
+        context.lineTo(warpXAt(strand, i, y), y);
+      }
+    };
+    context.beginPath();
+    trace(threadTop, threadTop + (centerY - threadTop) * progress);
+    const tail = threadBottom - ((i * 7) % 11) * step * 0.6;
+    trace(tail, tail - (tail - centerY) * progress);
+    context.stroke();
+  });
+
+  context.strokeStyle = weftFade;
+  rows.forEach((strand, j) => {
+    const yDistance = (strand.position - centerY) / (titleHeight * 2.3);
+    context.globalAlpha =
