+      clamp((threadBottom - strand.position) / (titleHeight * 0.5)) *
+      lowerContrast(strand.position);
+    const start = rowStart(strand.position);
+    const progress = Math.max(0.02, clamp((elapsed - start) / WEFT_TRAVEL));
+    const fromLeft = j % 2 === 0;
+    const startX = fromLeft ? threadLeft : threadRight;
+    const tip = fromLeft
+      ? threadLeft + (threadRight - threadLeft) * progress
+      : threadRight - (threadRight - threadLeft) * progress;
+    const edgeY = strand.position + (1.5 - (j % 4)) * step * 0.8;
+    const yAt = (x: number) => {
+      const gathered = focus(x - (left + titleWidth / 2), titleWidth * 1.6);
+      return edgeY + (strand.position - edgeY + strand.offset) * gathered;
+    };
+    strokeWeft(context, startX, tip, 18, yAt);
+  });
+
+  if (working) {
+    const halfHeight = titleHeight * 0.6;
+    const workingFade = context.createLinearGradient(
+      0,
+      working.y - halfHeight,
+      0,
+      working.y + halfHeight,
+    );
+    workingFade.addColorStop(0, 'rgba(159, 137, 199, 0)');
+    workingFade.addColorStop(0.5, 'rgba(159, 137, 199, 0.65)');
+    workingFade.addColorStop(1, 'rgba(159, 137, 199, 0)');
+    context.strokeStyle = workingFade;
+    context.lineWidth = step * 0.32;
+    columns.forEach((strand, i) => {
+      if (strand.position < courseLeft || strand.position > courseRight) return;
+      context.globalAlpha = (i % 4 ? 0.22 : 1) * (1 - working.pack);
+      context.beginPath();
+      for (let point = 0; point <= 8; point++) {
+        const y = working.y - halfHeight + (halfHeight * point) / 4;
+        const x = warpXAt(strand, i, y);
+        if (point === 0) context.moveTo(x, y);
+        else context.lineTo(x, y);
+      }
+      context.stroke();
+    });
+  }
+
+  // One continuous weft per course. The chart dyes lengths of that yarn.
+  const titleColumnStart = columns.indexOf(titleColumns[0]);
+  passes.forEach((pass) => {
+    if (pass.age < 0) return;
+    const row = titleRows[pass.rowIndex];
+    const fromLeft = pass.index % 2 === 0;
+    const from = fromLeft ? left : left + titleWidth;
+    const to = Math.max(left, Math.min(left + titleWidth, pass.tip));
+    const yAt = (x: number) =>
+      pass.y +
+      row.offset * focus(x - (left + titleWidth / 2), titleWidth * 1.6);
+    const dyedYarn = context.createLinearGradient(
+      left,
+      0,
+      left + titleWidth,
+      0,
+    );
+    dyedYarn.addColorStop(0, 'rgba(167, 139, 250, 0)');
+    titleColumns.forEach((column, i) => {
+      const color = `rgba(167, 139, 250, ${dye[pass.rowIndex * titleColumns.length + i]})`;
+      for (const edge of [-0.4, 0.4]) {
+        dyedYarn.addColorStop(
+          clamp((column.position - left + step * edge) / titleWidth),
+          color,
+        );
+      }
+    });
+    dyedYarn.addColorStop(1, 'rgba(167, 139, 250, 0)');
+    context.globalAlpha = 1;
+    context.strokeStyle = dyedYarn;
+    context.lineCap = 'butt';
+    context.lineWidth = step * 0.88;
+    strokeWeft(context, from, to, step, yAt);
+
+    context.strokeStyle = '#bfa6e8';
+    context.lineWidth = step * 0.24;
+    titleColumns.forEach((column, i) => {
+      if ((i + pass.index) % 2) return;
+      if (fromLeft ? column.position > pass.tip : column.position < pass.tip)
+        return;
+      const coverage = dye[pass.rowIndex * titleColumns.length + i];
+      if (coverage < 0.13) return;
+      const x = warpXAt(column, titleColumnStart + i, pass.y);
+      const y = yAt(column.position);
+      context.globalAlpha = coverage * 0.38;
+      context.beginPath();
+      context.moveTo(x, y - step * 0.46);
+      context.lineTo(x, y + step * 0.46);
+      context.stroke();
+    });
+  });
+
+  if (working) {
+    const row = titleRows[working.rowIndex];
+    const fromLeft = working.index % 2 === 0;
+    const yAt = (x: number) =>
+      working.y +
+      row.offset * focus(x - (left + titleWidth / 2), titleWidth * 1.6) +
+      Math.cos((Math.PI * (x - left)) / (step * 4)) *
+        step *
+        0.45 *
+        (1 - working.pack);
+    context.strokeStyle = '#a78bfa';
+    context.globalAlpha =
+      (working.index < 2 ? 0.85 : 0.55) * (1 - easeOut(working.pack));
+    context.lineWidth = step * 0.65;
+    context.lineCap = 'round';
+    const enteredLeft = fromLeft ? courseLeft : working.tip;
+    const enteredRight = fromLeft ? working.tip : courseRight;
+    let yarnStart = enteredLeft;
+    columns.forEach((column, i) => {
+      if (i % 4 || (Math.floor(i / 4) + working.index) % 2) return;
+      const x = warpXAt(column, i, working.y);
+      if (x < enteredLeft || x > enteredRight) return;
+      const gap = step * 0.55 * (1 - working.pack);
+      strokeWeft(
+        context,
+        yarnStart,
+        Math.max(yarnStart, x - gap),
+        step / 2,
+        yAt,
+      );
+      yarnStart = Math.min(enteredRight, x + gap);
+    });
+    strokeWeft(context, yarnStart, enteredRight, step / 2, yAt);
+    context.strokeStyle = '#af96d8';
+    context.lineWidth = step * 0.32;
+    columns.forEach((column, i) => {
+      if (i % 4 || (Math.floor(i / 4) + working.index) % 2) return;
+      if (column.position < courseLeft || column.position > courseRight) return;
+      if (
+        fromLeft ? column.position > working.tip : column.position < working.tip
+      )
+        return;
+      const x = warpXAt(column, i, working.y);
+      const y = yAt(column.position);
+      context.globalAlpha = 0.65 * (1 - working.pack);
+      context.beginPath();
+      context.moveTo(x, y - step);
+      context.lineTo(x, y + step);
+      context.stroke();
+    });
+  }
+  context.globalAlpha = 1;
+}
+
+export function WovenTitle({
+  onSubtitleReady,
+}: {
+  onSubtitleReady: () => void;
+}) {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const buttonRef = useRef<HTMLButtonElement>(null);
+  const guideRef = useRef<SVGSVGElement>(null);
+  const onSubtitleReadyRef = useRef(onSubtitleReady);
+  onSubtitleReadyRef.current = onSubtitleReady;
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    const button = buttonRef.current;
+    const guide = guideRef.current;
+    const section = canvas?.closest('section');
+    const subtitle = section?.querySelector('p');
+    const context = canvas?.getContext('2d');
+    if (!canvas || !button || !guide || !section || !subtitle || !context)
+      return;
+
+    const reducedMotion = window.matchMedia(
+      '(prefers-reduced-motion: reduce)',
+    ).matches;
+    let loom: Loom;
+    let frame = 0;
+    let subtitleShown = false;
+    let finished = false;
+    let active = true;
+    const startTime = performance.now() - (reducedMotion ? DURATION : 0);
+    const lastPulse = { x: 0, y: 0, time: 0 };
+
+    const schedule = () => {
+      if (!frame && loom) frame = requestAnimationFrame(render);
+    };
+    const render = (now: number) => {
+      frame = 0;
+      if (!loom) return;
+      const elapsed = Math.max(0, now - startTime);
+      let moving = false;
+      for (const strand of [...loom.columns, ...loom.rows]) {
+        const age = now - strand.pluckedAt;
+        strand.offset =
+          age >= 0 && age < 1200
+            ? strand.amplitude * Math.sin(age * 0.052) * Math.exp(-age / 380)
+            : 0;
+        moving ||= strand.amplitude > 0.15 && age < 1200;
+      }
+      drawScene(
+        context,
+        loom,
+        reducedMotion ? DURATION : elapsed,
+        document.documentElement.classList.contains('dark'),
+      );
+      if (elapsed >= DURATION - 500 && !subtitleShown) {
+        subtitleShown = true;
+        onSubtitleReadyRef.current();
+      }
+      if (elapsed >= DURATION) finished = true;
+      if (elapsed < DURATION || moving) schedule();
+    };
+    const resize = () => {
+      if (!active) return;
+      const sectionRect = section.getBoundingClientRect();
+      const guideRect = guide.getBoundingClientRect();
+      const { width, height } = sectionRect;
+      if (!width || !height || !guideRect.width || !guideRect.height) return;
+      const ratio = Math.min(window.devicePixelRatio || 1, 2);
+      canvas.width = Math.round(width * ratio);
+      canvas.height = Math.round(height * ratio);
+      context.setTransform(ratio, 0, 0, ratio, 0, 0);
+      loom = makeLoom(
+        sectionRect,
+        guideRect,
+        subtitle.getBoundingClientRect(),
+        getComputedStyle(section).fontFamily,
+      );
+      button.style.left = `${loom.left}px`;
+      button.style.width = `${loom.titleWidth}px`;
+      button.style.height = `${loom.titleHeight}px`;
+      button.style.top = `${loom.top}px`;
+      schedule();
+    };
+    const pulse = (event: MouseEvent | PointerEvent, force = false) => {
+      if (!finished || reducedMotion || !loom) return;
+      const bounds = section.getBoundingClientRect();
+      const keyboard = event.type === 'click' && event.detail === 0;
+      const x = keyboard ? bounds.width / 2 : event.clientX - bounds.left;
+      const y = keyboard ? loom.centerY : event.clientY - bounds.top;
+      const now = performance.now();
+      if (
+        !force &&
+        (now - lastPulse.time < 70 ||
+          Math.hypot(x - lastPulse.x, y - lastPulse.y) < loom.step * 1.5)
+      )
+        return;
+      lastPulse.x = x;
+      lastPulse.y = y;
+      lastPulse.time = now;
+      const pluck = (strands: Strand[], position: number, strength: number) => {
+        const radius = force ? loom.fontSize * 0.42 : loom.step * 3.5;
+        for (const strand of strands) {
+          const distance = Math.abs(strand.position - position);
+          if (distance > radius) continue;
+          strand.amplitude =
+            loom.step * strength * Math.exp(-((distance / radius) ** 2));
+          strand.pluckedAt = now + (force ? (distance / loom.step) * 14 : 0);
+        }
+      };
+      pluck(loom.columns, x, 1.25);
+      pluck(loom.rows, y, 0.7);
+      schedule();
+    };
+    const onPointerEnter = (event: PointerEvent) => {
+      if (event.pointerType === 'mouse') pulse(event, true);
+    };
+    const onPointerMove = (event: PointerEvent) => {
+      if (event.pointerType === 'mouse') pulse(event);
+    };
+    const onClick = (event: MouseEvent) => pulse(event, true);
+    const observer = new ResizeObserver(resize);
+    const themeObserver = new MutationObserver(schedule);
+    observer.observe(section);
+    observer.observe(guide);
+    observer.observe(subtitle);
+    themeObserver.observe(document.documentElement, {
+      attributes: true,
+      attributeFilter: ['class'],
+    });
+    button.addEventListener('pointerenter', onPointerEnter);
+    button.addEventListener('pointermove', onPointerMove);
+    button.addEventListener('click', onClick);
+    resize();
+    document.fonts.ready.then(resize);
+    return () => {
+      active = false;
+      cancelAnimationFrame(frame);
+      observer.disconnect();
+      themeObserver.disconnect();
+      button.removeEventListener('pointerenter', onPointerEnter);
+      button.removeEventListener('pointermove', onPointerMove);
+      button.removeEventListener('click', onClick);
+    };
+  }, []);
+
+  return (
+    <>
+      <canvas
+        ref={canvasRef}
+        className="pointer-events-none absolute inset-0 h-full w-full"
+        aria-hidden="true"
+      />
+      <button
+        ref={buttonRef}
+        type="button"
+        aria-label="태피스토리 실 튕기기"
+        className="absolute z-10 cursor-pointer touch-manipulation rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-500"
+      />
+      <div>
+        <svg
+          ref={guideRef}
+          viewBox="0 0 1200 300"
+          fontSize={200}
+          className="title-svg invisible mx-auto w-full max-w-xl md:max-w-[1152px]"
+          aria-hidden="true"
+        />
+      </div>
+    </>
+  );
+}
